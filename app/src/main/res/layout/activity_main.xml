<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <!-- no background here: the window background is the only full-screen fill (less overdraw) -->

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:padding="12dp">

            <!-- ============ DRIVE PANEL ============ -->
            <LinearLayout
                android:id="@+id/drivePanel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="38"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingLeft="20dp"
                android:paddingTop="16dp"
                android:paddingRight="20dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/gps"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.12"
                        android:text="GPS"
                        android:textColor="@color/text3"
                        android:textSize="11sp" />

                    <!-- shown only when a new version is on GitHub: tap to install -->
                    <TextView
                        android:id="@+id/updChip"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginEnd="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:letterSpacing="0.1"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:singleLine="true"
                        android:textSize="11sp"
                        android:visibility="gone" />

                    <!-- fixed width: updating the % never re-lays-out the panel -->
                    <TextView
                        android:id="@+id/ram"
                        android:layout_width="78dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/ripple_rect"
                        android:gravity="center_vertical|end"
                        android:letterSpacing="0.12"
                        android:paddingEnd="6dp"
                        android:singleLine="true"
                        android:text="RAM"
                        android:textColor="@color/text3"
                        android:textSize="11sp" />

                    <ImageButton
                        android:id="@+id/camBtn"
                        android:layout_width="34dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/ripple_rect"
                        android:contentDescription="Dash cam"
                        android:padding="5dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_videocam"
                        android:tint="@color/text2" />

                    <ImageView
                        android:id="@+id/wifi"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:alpha="0.25"
                        android:src="@drawable/ic_wifi"
                        android:tint="@color/text2" />
                </LinearLayout>

                <!-- Header: speed (left) and clock (right) share one row, so the car gets everything below.
                     Text sizes are set at runtime from the panel's real size (see sizeDrivePanel). -->
                <LinearLayout
                    android:id="@+id/header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- The speed and the parked greeting share this slot: "Good evening, <name>" while parked,
                         the speed fades back in as soon as the car moves. -->
                    <FrameLayout
                        android:id="@+id/speedSlot"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/speedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ripple_rect"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/speed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-light"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:text="--"
                            android:textColor="@color/text"
                            android:textSize="72sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/unit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.1"
                                android:singleLine="true"
                                android:text="KM/H"
                                android:textColor="@color/text2"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/heading"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.12"
                                android:singleLine="true"
                                android:text=""
                                android:textColor="@color/text3"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/greet"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="12dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/greetLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.16"
                            android:singleLine="true"
                            android:textColor="@color/text2"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/greetName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-light"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:textColor="@color/text"
                            android:textSize="40sp" />
                    </LinearLayout>
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/clockBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/clock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-light"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:text="00:00"
                            android:textColor="@color/text"
                            android:textSize="56sp" />

                        <TextView
                            android:id="@+id/date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="2dp"
                            android:singleLine="true"
                            android:textColor="@color/text2"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <xyz.ox1de.cardash.DriveView
                    android:id="@+id/car"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:paddingTop="6dp" />
            </LinearLayout>

            <Space
                android:id="@+id/gap"
                android:layout_width="12dp"
                android:layout_height="12dp" />

            <!-- ============ RIGHT COLUMN ============ -->
            <LinearLayout
                android:id="@+id/rightCol"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="62"
                android:orientation="vertical">

                <!-- Dash cam layout only: live front camera tile -->
                <FrameLayout
                    android:id="@+id/camTile"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="12dp"
                    android:layout_weight="64"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone">

                    <xyz.ox1de.cardash.AspectFrame
                        android:id="@+id/tileFrame"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="6dp">

                        <SurfaceView
                            android:id="@+id/tileSurface"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </xyz.ox1de.cardash.AspectFrame>

                    <TextView
                        android:id="@+id/tileLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="14dp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.12"
                        android:shadowColor="#CC000000"
                        android:shadowRadius="5"
                        android:text="FRONT"
                        android:textColor="#FFF2F3F5"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tileStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:text="Connecting to the dash cam…"
                        android:textColor="#FF8B919A"
                        android:textSize="13sp" />

                    <ImageView
                        android:id="@+id/tileExpand"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="14dp"
                        android:alpha="0.85"
                        android:src="@drawable/ic_fullscreen" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/media"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <xyz.ox1de.cardash.SquareImage
                        android:id="@+id/art"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_art"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_music" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/mApp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.12"
                            android:singleLine="true"
                            android:textAllCaps="true"
                            android:textColor="@color/accent"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:singleLine="true"
                            android:textColor="@color/text"
                            android:textSize="22sp" />

                        <TextView
                            android:id="@+id/artist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textColor="@color/text2"
                            android:textSize="15sp" />

                        <ProgressBar
                            android:id="@+id/prog"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="3dp"
                            android:layout_marginTop="16dp"
                            android:max="1000"
                            android:progressBackgroundTint="@color/line"
                            android:progressTint="@color/text" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/pos"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/text3"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/dur"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text3"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/prev"
                                android:layout_width="92dp"
                                android:layout_height="92dp"
                                android:background="@drawable/ripple_round"
                                android:padding="18dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_prev"
                                android:tint="@color/text" />

                            <ImageButton
                                android:id="@+id/play"
                                android:layout_width="96dp"
                                android:layout_height="96dp"
                                android:layout_marginStart="26dp"
                                android:layout_marginEnd="26dp"
                                android:background="@drawable/bg_play"
                                android:padding="26dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_play"
                                android:tint="@color/bg" />

                            <ImageButton
                                android:id="@+id/next"
                                android:layout_width="92dp"
                                android:layout_height="92dp"
                                android:background="@drawable/ripple_round"
                                android:padding="18dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_next"
                                android:tint="@color/text" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Optional: the music card shows a music app's own widget (Settings -> Music card) -->
                <xyz.ox1de.cardash.WidgetCard
                    android:id="@+id/widgetCard"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:padding="12dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/volCard"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">

                        <ImageButton
                            android:id="@+id/mute"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/ripple_round"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_volume"
                            android:tint="@color/text2" />

                        <SeekBar
                            android:id="@+id/vol"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingTop="14dp"
                            android:paddingBottom="14dp"
                            android:progressBackgroundTint="@color/line"
                            android:progressTint="@color/text"
                            android:thumbTint="@color/text" />

                        <TextView
                            android:id="@+id/volTxt"
                            android:layout_width="36dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:textColor="@color/text2"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/settings"
                        android:layout_width="64dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_card"
                        android:foreground="@drawable/ripple_rect"
                        android:padding="20dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_tune"
                        android:tint="@color/text2" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ============ DOCK ============ -->
        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:background="@drawable/bg_dock"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingRight="12dp" />
    </LinearLayout>

    <!-- ============ APP DRAWER ============ -->
    <FrameLayout
        android:id="@+id/drawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F507080A"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <GridView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:columnWidth="108dp"
            android:numColumns="auto_fit"
            android:padding="24dp"
            android:scrollingCache="false"
            android:scrollbars="none"
            android:stretchMode="spacingWidthUniform"
            android:verticalSpacing="10dp" />
    </FrameLayout>

    <!-- ============ SCREENSAVER ============ -->
    <xyz.ox1de.cardash.ClockView
        android:id="@+id/saver"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- ============ DASH CAM ============ -->
    <FrameLayout
        android:id="@+id/cam"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <xyz.ox1de.cardash.AspectFrame
            android:id="@+id/camFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <SurfaceView
                android:id="@+id/camSurface"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </xyz.ox1de.cardash.AspectFrame>

        <!-- rear: the head unit's own camera input -->
        <xyz.ox1de.cardash.AspectFrame
            android:id="@+id/rearFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <SurfaceView
                android:id="@+id/rearSurface"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </xyz.ox1de.cardash.AspectFrame>

        <TextView
            android:id="@+id/camStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_cam_status"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:maxWidth="560dp"
            android:paddingLeft="22dp"
            android:paddingTop="14dp"
            android:paddingRight="22dp"
            android:paddingBottom="14dp"
            android:textColor="#FFF2F3F5"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/camBar"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_gravity="top"
            android:background="@drawable/bg_cam_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingRight="16dp">

            <ImageButton
                android:id="@+id/camClose"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/ripple_round"
                android:contentDescription="Close"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close" />

            <TextView
                android:id="@+id/camTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.14"
                android:text="DASH CAM"
                android:textColor="#FFF2F3F5"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/camLive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.12"
                android:text="\u25CF LIVE"
                android:textColor="#FFFF4D4F"
                android:textSize="12sp"
                android:visibility="gone" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/camFront"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:text="FRONT"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/camRear"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:text="REAR"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/camInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="18dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:shadowColor="#CC000000"
            android:shadowRadius="6"
            android:textColor="#FFF2F3F5"
            android:textSize="16sp" />
    </FrameLayout>
</FrameLayout>

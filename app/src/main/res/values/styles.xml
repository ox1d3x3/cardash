<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#FF000000</color>
    <color name="card">#FF181B21</color>
    <color name="card_hi">#FF23272E</color>
    <color name="line">#FF343A43</color>
    <color name="text">#FFFFFFFF</color>
    <color name="text2">#FFAAB1BB</color>
    <color name="text3">#FF747B86</color>
    <color name="accent">#FF4F82FF</color>

    <string name="app_name">CarDash</string>
    <string name="keys_label">CarDash buttons (Back, Recent apps…)</string>
    <string name="keys_desc">Lets the Back and Recent apps buttons on the CarDash dock, and the shortcuts panel (notifications, quick settings, screenshot, split screen, lock, power menu), press Android\'s own keys. CarDash does not read the screen or anything you type, and does not watch other apps.</string>

    <style name="Theme.CarDash" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <!-- show the dark background instantly on cold start instead of a blank frame -->
        <item name="android:windowDisablePreview">false</item>
    </style>

    <style name="Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
    </style>

    <style name="DialogLight" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@drawable/bg_dialog_light</item>
    </style>
</resources>
